#!/usr/bin/env bash
# Archovive public CLI — delegates to frozen enterprise bundle when installed.
set -euo pipefail
CLI_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUNDLE_ROOT="${ARCHOVIVE_BUNDLE_ROOT:-}"

# install_archovive.sh sets ARCHOVIVE_BUNDLE_ROOT; legacy compat:
if [[ -z "${BUNDLE_ROOT}" && -n "${ARCHOVIVE_ENGINE_ROOT:-}" ]]; then
  BUNDLE_ROOT="${ARCHOVIVE_ENGINE_ROOT}"
fi

if [[ -z "${BUNDLE_ROOT}" && -d "${CLI_ROOT}/archovive-enterprise-5.0.0" ]]; then
  BUNDLE_ROOT="${CLI_ROOT}/archovive-enterprise-5.0.0"
fi

if [[ -n "${BUNDLE_ROOT}" && -x "${BUNDLE_ROOT}/bin/archovive" ]]; then
  export ARCHOVIVE_BUNDLE_ROOT="${BUNDLE_ROOT}"
  exec "${BUNDLE_ROOT}/bin/archovive" "$@"
fi

export PYTHONPATH="${CLI_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
if command -v python3 >/dev/null 2>&1; then
  exec python3 -m archovive.cli.cli_main "$@"
fi

echo "archovive: install enterprise bundle first — see docs/INSTALL.md" >&2
exit 1
