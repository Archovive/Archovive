# Enterprise tier — production stack (fail-closed defaults)
ARCHOVIVE_PRODUCT=enterprise
ARCHOVIVE_PRODUCTION=1
ARCHOVIVE_STORE_BACKEND=sql

# IAM — OIDC mandatory; static tokens break-glass only
ARCHOVIVE_OIDC_REQUIRED=1
ARCHOVIVE_OIDC_ISSUER=https://idp.example.com
ARCHOVIVE_OIDC_AUDIENCE=archovive-api
ARCHOVIVE_BREAK_GLASS_TOKEN=change-me-break-glass
# Do not set ARCHOVIVE_API_TOKEN in OIDC mode except equal to break-glass

# Transport — mTLS at ingress + optional app TLS
ARCHOVIVE_MTLS_REQUIRED=1
ARCHOVIVE_TLS_CERT=/etc/archovive/tls/server.crt
ARCHOVIVE_TLS_KEY=/etc/archovive/tls/server.key
ARCHOVIVE_TLS_CA=/etc/archovive/tls/ca.crt

# RBAC / ABAC
ARCHOVIVE_RBAC_ENFORCE=1
ARCHOVIVE_ABAC_ENFORCE=1
ARCHOVIVE_ABAC_ALLOWED_TENANTS=tenant-a,tenant-b
ARCHOVIVE_ABAC_DENY_PERMISSIONS=

# MCP
ARCHOVIVE_MCP_TOKEN=change-me-mcp
# ARCHOVIVE_MCP_AUTH_DISABLED=0

# CLI token signing (non-default seed or explicit key)
ARCHOVIVE_CLI_TOKEN_SIGNING_KEY=change-me-cli-signing-key
ARCHOVIVE_SIGNING_KEY_PATH=/etc/archovive/signing/ed25519.pem

# Audit — immutable hash-chained log
ARCHOVIVE_SECURITY_AUDIT_LOG=/var/log/archovive/security_audit.jsonl

# SIEM real-time connector
ARCHOVIVE_SIEM_REALTIME=1
ARCHOVIVE_SIEM_ENDPOINT=https://siem.example.com/services/collector/event
ARCHOVIVE_SIEM_TOKEN=change-me-siem
ARCHOVIVE_SIEM_FORMAT=hec
ARCHOVIVE_SIEM_SOURCETYPE=archovive:security_audit

# Supply chain verification (release ops)
# cosign verify-blob --key deploy/supply-chain/cosign.pub --signature artifact.cosign.sig artifact

# Vault (optional secret backend)
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=
ARCHOVIVE_MCP_TOKEN_VAULT_PATH=secret/data/archovive/mcp

# Database
POSTGRES_USER=archovive
POSTGRES_PASSWORD=change-me
POSTGRES_DB=archovive

# Integrations
PAGERDUTY_ROUTING_KEY=
SLACK_BOT_TOKEN=
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
GITHUB_TOKEN=
